#!/usr/bin/env python3
"""A stand-in for ddsim, for the tests.

It runs the steering file as ddsim does (DD4hepSimulation.readSteeringFile:
exec() with separate global and local namespaces), with the stand-ins for
DD4hep's DDSim and g4units (tests/fakes/python) and DDML's Python package
(tests/fakes/ddml), so that the steering file takes its own options out of
the command line, as it does in ddsim (DDML's --ml-model, and --ml-config for
FaSiNaTe's scripts/ddsim_steer_models.py), and sets up the fast simulation,
which this keeps. Then, as ddsim does, it reads what is left of the command
line, failing on anything the simulation stages don't give, checks that it is
run as they run ddsim (from DDML's scripts/ folder, with a compact file and a
hidden output file ending in .root), and copies the first --numberOfEvents
events of the input (the JSON "LCIO" of tests/fakes/python/pyLCIO) into the
output, noting which simulator it was (geant4, without a fast simulation, or
else the presets and model configurations it was given, by their presets or
plugins), the DDML model configurations the steering file set up (models),
and the seed it was given (--random.seed), if any. A configuration's
embedded-Python plugin imports its module (PythonModule) in ddsim's own
interpreter as Geant4 sets it up, so the module is looked for on the Python
path the steering file left, failing as DDML does where there is none, but
not run (it may need PyTorch): each configuration notes where it was found
(python_module).

It fails when "<simulator> <input file name>" matches the shell pattern in
$FAKE_CONTROL/ddsim_fail, if there is one, e.g. "geant4 *en80*" or "* *en80*".
(The environment the stages run in is a clean one, so a test can't pass that
in a variable; the fake DDML build's env file sets FAKE_CONTROL.)

As it copies the events, it prints the lines ddsim prints for each (the
timing benchmark, ddml_timing/events.py, reads them): GenerationInit's
"Initializing event", the particle handler's "Begin event action", DDML's line
for each shower it places in the barrel (one per model configuration of the
ECal barrel, here: each event's particles are taken to enter the barrel, so
the endcap's configurations place none) and the output's "Saving EDM4hep
event"; then, if the input ran out first, the start of one more event, which
finds the input ended, and ddsim's timing summary. With
$FAKE_CONTROL/ddsim_event_seconds it takes that long over each event, and with
$FAKE_CONTROL/ddsim_run_inference it calls the run_inference() of each barrel
configuration's embedded-Python module once per event, as DDML does for each
shower.
"""

import fnmatch
import importlib
import importlib.util
import io
import json
import os
import sys
import time


def fail(message, status=2):
    print("ddsim (fake): " + message)
    sys.exit(status)


# What the steering file is given to simulate with, by name, before it takes
# those options out of the command line
named, args, i = [], sys.argv[1:], 0
steering = None
while i < len(args):
    if args[i] in ("--ml-model", "--ml-config", "--steeringFile") and i + 1 < len(args):
        option, value = args[i], args[i + 1]
        if option == "--steeringFile":
            steering = value
        elif option == "--ml-config":
            try:
                entry = json.loads(value)
            except ValueError:
                entry = None
            named.append(str(entry.get("preset") or entry.get("plugin", "?").split("/")[0])
                         if isinstance(entry, dict) else "?")
        else:
            named.append(value)
        i += 2
    else:
        i += 1
if steering is None:
    fail("no --steeringFile")
if not os.path.isfile(steering):
    fail("--steeringFile %s not found" % steering)

# As DD4hepSimulation.readSteeringFile, which keeps the DD4hepSimulation the
# steering file makes
from DDSim.DD4hepSimulation import DD4hepSimulation  # noqa: E402
from g4units import GeV  # noqa: E402

globs, locs = {}, {}
exec(compile(io.open(steering).read(), steering, "exec"), globs, locs)
made = [obj for obj in locs.values() if isinstance(obj, DD4hepSimulation)]
if len(made) != 1:
    fail("the steering file %s made %d DD4hepSimulation objects, not one" % (steering, len(made)))
physics = made[0].physics._values.get("user_physics")
configs = list(getattr(physics, "configs", None) or [])
# The modules of the embedded-Python plugins, as EmbeddedPyInference::initialize()
# imports them: here only found
modules = []
for config in configs:
    module = dict(config.plugin_properties).get("PythonModule")
    if not module:
        modules.append(None)
        continue
    try:
        spec = importlib.util.find_spec(module)
    except (ImportError, ValueError):
        spec = None
    if spec is None or not spec.origin:
        fail("EmbeddedPyInference init: ModuleNotFoundError: No module named '%s'" % module)
    modules.append(spec.origin)

# Then the rest of the command line, as the steering file left it
args = sys.argv[1:]
options = {"seed": None}
i = 0
while i < len(args):
    arg = args[i]
    if arg.startswith("--numberOfEvents="):
        options["numberOfEvents"] = int(arg.split("=", 1)[1])
        i += 1
    elif arg.startswith("--random.seed="):
        options["seed"] = int(arg.split("=", 1)[1])
        i += 1
    elif arg in ("--steeringFile", "--compactFile", "--inputFiles", "--outputFile"):
        options[arg[2:]] = args[i + 1]
        i += 2
    else:
        fail("unexpected argument %s" % arg)
for key in ("steeringFile", "compactFile", "inputFiles", "outputFile", "numberOfEvents"):
    if key not in options:
        fail("no --%s" % key)

scripts = os.path.join(os.environ.get("DDML_SOURCE_DIR", "(unset)"), "scripts")
if os.path.realpath(os.getcwd()) != os.path.realpath(scripts):
    fail("run from %s, not from DDML's %s" % (os.getcwd(), scripts))
for key in ("compactFile", "inputFiles"):
    if not os.path.isfile(options[key]):
        fail("--%s %s not found" % (key, options[key]))
name = os.path.basename(options["outputFile"])
if not name.startswith(".") or not name.endswith(".root"):
    fail("the output %s should be hidden, and end in .root for EDM4hep" % options["outputFile"])
with open(options["inputFiles"]) as stream:
    events = [json.loads(line) for line in stream if '"event"' in line]
if options["numberOfEvents"] >= 0:
    events = events[:options["numberOfEvents"]]
if bool(configs) != bool(named):
    fail("the steering file set up %d DDML model(s), but was given %d" % (len(configs),
                                                                         len(named)))
simulator = "+".join(named) if configs else "geant4"
control = os.path.join(os.environ.get("FAKE_CONTROL", "/nonexistent"), "ddsim_fail")
if os.path.exists(control):
    with open(control) as stream:
        pattern = stream.read().strip()
    if fnmatch.fnmatch("%s %s" % (simulator, os.path.basename(options["inputFiles"])), pattern):
        fail("failing on %s, as %s says" % (options["inputFiles"], control), 3)
models = [{"plugin": config.plugin,
           "plugin_properties": dict(config.plugin_properties),
           "python_module": module,
           "detector": config.geometry.ecal.detector,
           "applicable_particles": sorted(config.applicable_particles),
           "triggers_gev": dict((p, e / GeV) for p, e in config.triggers.items()),
           "correct_angles": config.correct_angles} for config, module in zip(configs, modules)]

# The lines ddsim prints for each event, and its timing summary
control_dir = os.environ.get("FAKE_CONTROL", "/nonexistent")
seconds = 0.0
if os.path.exists(os.path.join(control_dir, "ddsim_event_seconds")):
    with open(os.path.join(control_dir, "ddsim_event_seconds")) as stream:
        seconds = float(stream.read().strip() or 0)
# The configurations that place showers: the ECal barrel's, which each event's
# particles are taken to enter (an endcap's configuration places none)
in_barrel = [config.geometry.ecal.detector == "EcalBarrel" for config in configs]
# Each configuration's run_inference(), where it is to be called
inference = [None] * len(configs)
if os.path.exists(os.path.join(control_dir, "ddsim_run_inference")):
    import numpy
    for index, config in enumerate(configs):
        module = dict(config.plugin_properties).get("PythonModule")
        if module:
            inference[index] = importlib.import_module(module).run_inference
started = time.time()
for number in range(1, len(events) + 1):
    print("GenerationInit   INFO  +++ Initializing event %d. Within run:0 event %d."
          % (number, number))
    print("LCIOFileReader   INFO  read collection MCParticle from event %d in run 0 " % (number - 1))
    print("ParticleHandler  INFO  +++ Event %d Begin event action. Access event related "
          "information." % (number - 1))
    for run_inference, barrel in zip(inference, in_barrel):
        if not barrel:
            continue
        if run_inference is not None:
            run_inference([numpy.array([[50.0]], dtype=numpy.float32),
                           numpy.array([[10.0]], dtype=numpy.float32),
                           numpy.array([[90.0]], dtype=numpy.float32)])
        print("PolyhedraBarrelGeometry::localToGlobal INFO  nLayer = 30")
    if seconds:
        time.sleep(seconds)
    print("Geant4Output2EDM4hep INFO  +++ Saving EDM4hep event %d run 0." % (number - 1))
if options["numberOfEvents"] < 0 or len(events) < options["numberOfEvents"]:
    print("GenerationInit   INFO  +++ Initializing event %d. Within run:0 event %d."
          % (len(events) + 1, len(events) + 1))
    print("UI               INFO  ++ End of file reached, ending run...")
print("GenerationInit   WARN  +++ Finished run 0 after %d events (%d events in total)"
      % (len(events), len(events)))
spent = time.time() - started
print("DDSim            INFO Total Time:   %.2f s (User), %.2f s (System)" % (spent + 1, 0.1))
print("DDSim            INFO StartUp Time: %.2f s, Processing and Init: %.2f s (~%.2f s/Event) "
      % (1.0, spent, spent / max(len(events), 1)))
with open(options["outputFile"], "w") as stream:
    json.dump({"simulator": simulator, "compact": options["compactFile"],
               "seed": options["seed"], "models": models, "events": events}, stream)
print("ddsim (fake): simulated %d events of %s with %s" % (len(events), options["inputFiles"],
                                                          simulator))
